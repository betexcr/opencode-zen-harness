# Transport: 'zen' (direct HTTP, needs the key below) or 'opencode-cli'
# (routes via the local `opencode` CLI so the -free models work with no key).
# HARNESS_TRANSPORT=zen

# OpenCode Zen credentials (required for the 'zen' transport)
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=sk-...your-key-here

# Optional: override the default target workspace. If unset, the current
# working directory is used as the sandbox root.
# HARNESS_WORKSPACE=C:\path\to\project

# --- Model routing -----------------------------------------------------------
# The defaults route every role to a `-free` Zen model. The free tier is only
# served INSIDE the OpenCode client; external API keys get HTTP 403
# (FreeTierError). For standalone runs, override each role with an
# openai-compatible Zen model your key can call (e.g. glm-5.1, kimi-k2.6,
# minimax-m2.7, qwen3.7-plus), or point at any OpenAI-compatible endpoint.
#
# Run `node src/index.ts --ping` to verify each routed model before a real run.
#
# Roles: ORCHESTRATOR, PLANNER, REPO_EXPLORER, BUILDER, TEST_ENGINEER,
#        DEBUGGER, REVIEWER, SECURITY_AUDITOR, RELEASE
#
# Global fallback for any unset role:
# HARNESS_MODEL=glm-5.1
#
# Per-role overrides:
# HARNESS_MODEL_ORCHESTRATOR=glm-5.1
# HARNESS_MODEL_PLANNER=glm-5.1
# HARNESS_MODEL_REPO_EXPLORER=glm-5.1
# HARNESS_MODEL_BUILDER=glm-5.1
# HARNESS_MODEL_TEST_ENGINEER=glm-5.1
# HARNESS_MODEL_DEBUGGER=glm-5.1
# HARNESS_MODEL_REVIEWER=glm-5.1
# HARNESS_MODEL_SECURITY_AUDITOR=glm-5.1
# HARNESS_MODEL_RELEASE=glm-5.1

# Optional tuning
# HARNESS_MAX_AGENT_STEPS=12
# HARNESS_MAX_RETRIES=4

# opencode-cli transport (HARNESS_TRANSPORT=opencode-cli)
# HARNESS_OPENCODE_BIN=opencode
# HARNESS_OPENCODE_PROVIDER=opencode
# HARNESS_OPENCODE_TIMEOUT_MS=180000
# HARNESS_OPENCODE_PURE=false
