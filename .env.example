# =============================================================================
# opencode-zen-harness — environment example
# Copy to `.env` and edit. `.env` is gitignored.
# =============================================================================

# --- Transport ---------------------------------------------------------------
# 'opencode-cli' routes each model call through the local `opencode` CLI, which
#   reuses the OpenCode client's own auth — so the -free Zen models work with no
#   API key. (One CLI process per agent turn; slower.)
# 'zen' calls the Zen HTTP API directly (needs the key below and a funded
#   account or a non-gated, openai-compatible model).
HARNESS_TRANSPORT=opencode-cli

# --- Credentials (only needed for HARNESS_TRANSPORT=zen) ---------------------
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=sk-...your-key-here

# --- Workspace ---------------------------------------------------------------
# Target root for the sandbox. If unset, the current working directory is used.
# HARNESS_WORKSPACE=C:\path\to\project

# --- Agent setup: role -> model ----------------------------------------------
# This is the topology in use here (all -free, served via the opencode-cli
# transport). The defaults live in src/config/models.ts (AGENT_MODEL_ROUTING);
# the variables below override them per role at runtime.
#
#   ORCHESTRATOR      step-5-preview-free        state machine, routing decisions
#   PLANNER           big-pickle                 goal decomposition
#   REPO_EXPLORER     longcat-2.5-preview-free   repo structural index
#   BUILDER           step-5-preview-free        code generation
#   TEST_ENGINEER     nemotron-3-ultra-free      test authoring
#   DEBUGGER          big-pickle                 failure diagnosis + patch
#   REVIEWER          big-pickle                 diff review vs goal
#   SECURITY_AUDITOR  big-pickle                 security audit
#   RELEASE           mimo-v2.6-flash-free       lint/build/test gate + commit
#
# Verify the whole set with:  node src/index.ts --ping
#
# Global fallback applied to any role without its own override:
# HARNESS_MODEL=glm-5.3
#
# Per-role overrides (uncomment and edit to change a model):
# HARNESS_MODEL_ORCHESTRATOR=step-5-preview-free
# HARNESS_MODEL_PLANNER=big-pickle
# HARNESS_MODEL_REPO_EXPLORER=longcat-2.5-preview-free
# HARNESS_MODEL_BUILDER=step-5-preview-free
# HARNESS_MODEL_TEST_ENGINEER=nemotron-3-ultra-free
# HARNESS_MODEL_DEBUGGER=big-pickle
# HARNESS_MODEL_REVIEWER=big-pickle
# HARNESS_MODEL_SECURITY_AUDITOR=big-pickle
# HARNESS_MODEL_RELEASE=mimo-v2.6-flash-free
#
# Note: the -free tier is only served INSIDE the OpenCode client. On the 'zen'
# transport, override the roles with an openai-compatible model your key can
# call (e.g. glm-5.3, kimi-k3, minimax-m3, qwen3.8-max) or any OpenAI-compatible
# endpoint via OPENCODE_ZEN_BASE_URL.

# --- Tuning ------------------------------------------------------------------
# HARNESS_MAX_AGENT_STEPS=12
# HARNESS_MAX_RETRIES=4

# --- opencode-cli transport options ------------------------------------------
# HARNESS_OPENCODE_BIN=opencode
# HARNESS_OPENCODE_PROVIDER=opencode
# HARNESS_OPENCODE_TIMEOUT_MS=180000
# HARNESS_OPENCODE_PURE=false
